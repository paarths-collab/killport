{
  "name": "42-windows-dry-run-zero-mutation",
  "description": "Legacy --dry-run on Windows for 3000: node.exe (PID 4120) is planned for termination, and nothing is terminated.",
  "contract": "identity",
  "platform": "windows",
  "args": ["--dry-run", "--json", "3000"],
  "commands": {
    "netstat -ano": {"stdout_file": "../../windows/netstat_ano.txt"},
    "tasklist /FO CSV /NH": {"stdout_file": "../../windows/tasklist_csv.txt"}
  },
  "expect": {
    "exit": 0,
    "json_paths": {"#": 1, "0.port": "3000", "0.pid": "4120", "0.status": "planned", "0.dry_run": true},
    "signals": [],
    "no_mutation": true
  }
}
