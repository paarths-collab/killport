{
  "name": "06-linux-near-miss-13000",
  "description": "Real Linux capture: 13000 (python3 PID 279) is a near miss for 3000 and must not be selected.",
  "contract": "tcp-listener",
  "platform": "linux",
  "args": ["plan", "--json", "3000"],
  "commands": {
    "lsof -nP +c 0 -iTCP -sTCP:LISTEN -FpcnT": {"stdout_file": "../../linux/lsof_listen.txt"}
  },
  "files": {"/proc/net/tcp": "../../sockets/linux_proc_net_tcp.txt", "/proc/net/tcp6": "../../sockets/linux_proc_net_tcp6.txt"},
  "procs": [{"pid": 277, "start": "100277", "name": "python3"}, {"pid": 279, "start": "100279", "name": "python3"}],
  "expect": {
    "exit": 0,
    "json_paths": {"resources.#": 1, "resources.0.pid": 277, "resources.0.ports": [3000]},
    "no_mutation": true
  }
}
