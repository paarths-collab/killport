{
  "name": "05-linux-same-pid-two-ports",
  "description": "One process owns 3000 and 3001. It is planned once, with both ports, and each endpoint names the same resource.",
  "contract": "tcp-listener",
  "platform": "linux",
  "args": ["plan", "--json", "3000", "3001"],
  "commands": {
    "lsof -nP +c 0 -iTCP -sTCP:LISTEN -FpcnT": {"stdout_file": "lsof_same_pid_two_ports.txt"}
  },
  "files": {"/proc/net/tcp": "tcp_two_ports.txt"},
  "procs": [{"pid": 100, "start": "100100", "name": "node"}],
  "expect": {
    "exit": 0,
    "json_paths": {"resources.#": 1, "resources.0.pid": 100, "resources.0.ports": [3000, 3001], "endpoints.#": 2, "endpoints.1.resources.0": "proc:100:100100"},
    "no_mutation": true
  }
}
