{
  "name": "40-linux-dry-run-zero-mutation",
  "description": "Legacy --dry-run on Linux for 3000 and 13000 reports both as planned. Nothing is signalled, and any kill attempt would panic the read-only wrapper.",
  "contract": "identity",
  "platform": "linux",
  "args": ["--dry-run", "--json", "3000", "13000"],
  "commands": {
    "lsof -nP +c 0 -iTCP -sTCP:LISTEN -FpcnT": {"stdout_file": "../../linux/lsof_listen.txt"}
  },
  "files": {"/proc/net/tcp": "../../sockets/linux_proc_net_tcp.txt", "/proc/net/tcp6": "../../sockets/linux_proc_net_tcp6.txt"},
  "procs": [{"pid": 277, "start": "100277", "name": "python3"}, {"pid": 279, "start": "100279", "name": "python3"}],
  "expect": {
    "exit": 0,
    "json_paths": {"#": 2, "0.port": "3000", "0.pid": "277", "0.status": "planned", "0.dry_run": true, "1.port": "13000", "1.pid": "279", "1.status": "planned"},
    "signals": [],
    "no_mutation": true
  }
}
