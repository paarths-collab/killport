{
  "name": "03-linux-ipv6-bracketed-listener",
  "description": "Real Linux capture: IPv6 loopback listener [::1]:8080 from /proc/net/tcp6 and lsof is attributed to PID 278.",
  "contract": "tcp-listener",
  "platform": "linux",
  "args": ["plan", "--json", "8080"],
  "commands": {
    "lsof -nP +c 0 -iTCP -sTCP:LISTEN -FpcnT": {"stdout_file": "../../linux/lsof_listen.txt"}
  },
  "files": {"/proc/net/tcp": "../../sockets/linux_proc_net_tcp.txt", "/proc/net/tcp6": "../../sockets/linux_proc_net_tcp6.txt"},
  "procs": [{"pid": 278, "start": "100278", "name": "python3"}],
  "expect": {
    "exit": 0,
    "json_paths": {"resources.#": 1, "resources.0.pid": 278, "endpoints.0.port": 8080, "endpoints.0.occupied": true, "endpoints.0.visibility": "complete_for_requested_scope"},
    "no_mutation": true
  }
}
