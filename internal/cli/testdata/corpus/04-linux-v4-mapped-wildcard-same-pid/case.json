{
  "name": "04-linux-v4-mapped-wildcard-same-pid",
  "description": "One process listens on 0.0.0.0, [::] and the v4-mapped [::ffff:127.0.0.1] on port 3000. It is one resource, not three.",
  "contract": "tcp-listener",
  "platform": "linux",
  "args": ["plan", "--json", "3000"],
  "commands": {
    "lsof -nP +c 0 -iTCP -sTCP:LISTEN -FpcnT": {"stdout_file": "lsof_v4_v6_same_pid.txt"}
  },
  "files": {"/proc/net/tcp": "../../sockets/linux_proc_net_tcp.txt", "/proc/net/tcp6": "tcp6_v4mapped.txt"},
  "procs": [{"pid": 100, "start": "100100", "name": "node"}],
  "expect": {
    "exit": 0,
    "json_paths": {"resources.#": 1, "resources.0.pid": 100, "endpoints.0.resources.#": 1, "endpoints.0.visibility": "complete_for_requested_scope"},
    "no_mutation": true
  }
}
